# Valheim Docker - example environment file
#
# Copy this to `.env` and edit. `.env` is gitignored, this example is not - so
# never put real passwords or tokens in this file.
#
#   cp .env.example .env
#
# To use it with docker compose, add an `env_file` entry to the service:
#
#   services:
#     valheim:
#       env_file: .env
#
# Every variable is documented in docs/README.md. Commented-out lines show the
# default that applies when the variable is unset.

# ---------------------------------------------------------------------------
# Server basics
# ---------------------------------------------------------------------------
PORT=2456
NAME="Created With Valheim Docker"
WORLD="Dedicated"
# Change this. The server refuses to start with the placeholder password.
PASSWORD="Change Me! Please."
PUBLIC=1
TZ="America/Los_Angeles"

# Vanilla or BepInEx. BepInEx is required for the MODS variable below.
TYPE=Vanilla
# ENABLE_CROSSPLAY=0

# ---------------------------------------------------------------------------
# Updates and backups
# ---------------------------------------------------------------------------
AUTO_UPDATE=1
UPDATE_ON_START=0
AUTO_UPDATE_SCHEDULE="0 1 * * *"
# AUTO_BACKUP=0
# AUTO_BACKUP_SCHEDULE="*/15 * * * *"

# ---------------------------------------------------------------------------
# Mods (requires TYPE=BepInEx)
# ---------------------------------------------------------------------------
# Comma or newline separated. Supports zip, dll and cfg, plus Thunderstore
# wildcards such as Author-Package-* or Author-Package-1.*
# MODS="ValheimModding-Jotunn-*"

# Fail the whole install if any single mod fails (default), or set to true to
# install the mods that succeeded and only warn about the rest.
# MODS_CONTINUE_ON_FAILURE=false

# ---------------------------------------------------------------------------
# Mod download tuning
# ---------------------------------------------------------------------------
# Thunderstore sits behind Cloudflare, which throttles bursts of requests.
# If you see HTTP 429 errors during install, start by setting this to false.
# CONCURRENT_DOWNLOADS_ENABLED=true

# Total requests in flight, shared across mod downloads AND the range chunks a
# single large download splits into. Lower to 2 to reduce pressure without
# going fully serial.
# MAX_CONCURRENT_DOWNLOADS=4

# Attempts per request. Rate limited responses honor Retry-After and otherwise
# back off exponentially with jitter, capped at 60s.
# DOWNLOAD_RETRY_ATTEMPTS=5

# Milliseconds between concurrent download starts, so requests are spaced out
# instead of all opening at once. Set to 0 to disable.
# DOWNLOAD_STAGGER_MS=250

# Connection pool and timeout tuning. Defaults suit most setups; raise
# DOWNLOAD_REQUEST_TIMEOUT_SECS for very large archives on slow links.
# DOWNLOAD_POOL_MAX_IDLE_PER_HOST=8
# DOWNLOAD_POOL_IDLE_TIMEOUT_SECS=90
# DOWNLOAD_REQUEST_TIMEOUT_SECS=300
# DOWNLOAD_CONNECT_TIMEOUT_SECS=15

# ---------------------------------------------------------------------------
# Thunderstore authentication (optional)
# ---------------------------------------------------------------------------
# Service account API token (tss_...), created from your team's Service
# Accounts page. Sent as a Bearer token to thunderstore.io and its subdomains.
#
# This is optional: the endpoints used for mod listing, version resolution and
# downloads are public and work with no credentials. A token does NOT raise any
# rate limit, so it will not help with HTTP 429 errors - use the download
# settings above for that.
# THUNDERSTORE_TOKEN=

# Legacy and non-functional: Thunderstore ignores HTTP Basic auth rather than
# rejecting it, so these never authenticated anything. Kept for compatibility.
# THUNDERSTORE_USERNAME=
# THUNDERSTORE_PASSWORD=

# Override the API and download base URL, for mirrors or local testing.
# THUNDERSTORE_BASE_URL=https://thunderstore.io

# ---------------------------------------------------------------------------
# Notifications (optional)
# ---------------------------------------------------------------------------
# WEBHOOK_URL=
# WEBHOOK_INCLUDE_PUBLIC_IP=0
# PLAYER_EVENT_NOTIFICATIONS=0

# ---------------------------------------------------------------------------
# SteamCMD (optional)
# ---------------------------------------------------------------------------
# ADDITIONAL_STEAMCMD_ARGS=
# STEAMCMD_RETRY_ATTEMPTS=3
# STEAMCMD_RETRY_BASE_DELAY_SECS=5
